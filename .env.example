META_API_KEY=
# Paymob Unified Checkout (Intention API) - Dashboard > Settings > Account Info / Developers
# Server-side only, never expose to the client:
PAYMOB_SECRET_KEY=
# Client-side checkout key (safe to expose in browser):
NEXT_PUBLIC_PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
# Required by Unified Checkout as payment_methods (Developers > Payment Integrations > Online Card ID). No iframe/API key needed:
PAYMOB_INTEGRATION_ID=
# Optional mobile-wallet integration ID:
PAYMOB_WALLET_INTEGRATION_ID=
# Public app origin for Paymob notification/redirection URLs, e.g. https://your-app.vercel.app (no trailing slash):
NEXT_PUBLIC_APP_URL=
# Option A cafe line: your own WhatsApp number, E.164 digits e.g. 2010xxxxxxxx
CAFE_WHATSAPP_NUMBER=
# Vercel Blob (image/video storage) - Vercel > Storage > Blob > connect store, token is auto-set on Vercel; copy it here for local scripts
BLOB_READ_WRITE_TOKEN=
# Neon Postgres (app uses pooled, migrations use direct)
DATABASE_URL=
DATABASE_URL_POOLED=

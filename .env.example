META_API_KEY=
# XPay Hosted Checkout (test mode) - Dashboard > Developer > API Keys / Webhooks
# Server-side only, never expose to the client:
XPAY_SECRET_KEY=
XPAY_WEBHOOK_SECRET=
# Public app origin for the XPay return redirect, e.g. https://your-app.vercel.app (no trailing slash):
NEXT_PUBLIC_APP_URL=
# Option A cafe line: your own WhatsApp number, E.164 digits e.g. 2010xxxxxxxx
CAFE_WHATSAPP_NUMBER=
# Vercel Blob (image/video storage) - Vercel > Storage > Blob > connect store, token is auto-set on Vercel; copy it here for local scripts
BLOB_READ_WRITE_TOKEN=
# Neon Postgres (app uses pooled, migrations use direct)
DATABASE_URL=
DATABASE_URL_POOLED=

QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

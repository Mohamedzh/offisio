META_API_KEY=
# XPay Hosted Checkout (test mode) - Dashboard > Developer > API Keys / Webhooks
# Server-side only, never expose to the client:
XPAY_SECRET_KEY=
XPAY_WEBHOOK_SECRET=
# Public app origin for the XPay return redirect, e.g. https://your-app.vercel.app (no trailing slash):
NEXT_PUBLIC_APP_URL=
# Option A cafe line: your own WhatsApp number, E.164 digits e.g. 2010xxxxxxxx
CAFE_WHATSAPP_NUMBER=
# Vercel Blob (image/video storage) - Vercel > Storage > Blob > connect store, token is auto-set on Vercel; copy it here for local scripts
BLOB_READ_WRITE_TOKEN=
# Guardrails (docs/plan/06 6.3). Salt for hashed client IPs (any random string):
GUARD_SALT=
# Spend circuit breaker: daily ceiling in USD, estimated from Meta list prices in lib/guard.ts.
DEMO_DAILY_SPEND_USD=15
# Optional price overrides (defaults = Meta list prices 2026-10-30): META_PRICE_SPARK_IN_PER_M,
# META_PRICE_SPARK_CACHED_PER_M, META_PRICE_SPARK_OUT_PER_M, META_PRICE_SPARK_CONTRIBUTOR_*_PER_M,
# META_PRICE_IMAGE_PER_IMAGE
# Optional per-kind overrides, e.g. LIMIT_CHAT_IP=40 LIMIT_UPLOAD_GLOBAL=20 (kinds: CHAT, UPLOAD, IMAGE_EDIT, BOOKING, BLOB_TOKEN)
# Unpaid booking hold in minutes (default 30):
BOOKING_HOLD_MINUTES=
# Local dev only (ignored on Vercel): route non-PII calls (survey, specs, listing) to
#   modal       = our Muse Spark Open deployment on Modal (preferred; needs the MODAL_* vars)
#   contributor = muse-spark-1.3-contributor
OFFISIO_DEV_MODELS=
# Muse Spark Open on Modal (dev only): endpoint base URL and proxy token id/secret
MODAL_SPARK_URL=
MODAL_KEY=
MODAL_SECRET=
# Neon Postgres (app uses pooled, migrations use direct)
DATABASE_URL=
DATABASE_URL_POOLED=

# Parked (plan/06 O6): QStash simulated cafe order status, not used by the app
QSTASH_URL=
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
